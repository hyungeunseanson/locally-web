{
  "schemaVersion": 1,
  "application": "locally-web",
  "runtimePins": {
    "node": "24.20.0",
    "next": "16.3.5",
    "react": "19.2.3",
    "reactDom": "19.2.3",
    "openNextCloudflare": "1.19.6",
    "wrangler": "4.129.1",
    "compatibilityDate": "2026-09-08"
  },
  "limits": {
    "workerMemoryMiB": 128,
    "workerBundleUncompressedMiB": 64,
    "staticAssetCount": 20000,
    "staticAssetBytes": 26214400
  },
  "environments": {
    "canary": {
      "worker": "locally-web-opennext-canary",
      "incrementalCacheR2": "locally-opennext-incremental-cache-canary",
      "accessRequired": true,
      "workersDev": false,
      "previewUrls": false
    },
    "production": {
      "worker": "locally-web-opennext-production",
      "incrementalCacheR2": "locally-opennext-incremental-cache-production",
      "publicExperienceMediaR2": "locally-public-experience-canary",
      "publicExperienceMediaQueue": "locally-public-experience-media-mirror-production",
      "publicExperienceMediaDeadLetterQueue": "locally-public-experience-media-mirror-dlq-production",
      "experienceTranslationQueue": "locally-experience-translation-production",
      "experienceTranslationDeadLetterQueue": "locally-experience-translation-dlq-production",
      "publicExperienceMediaBaseUrl": "https://media-canary.locally-travel.com",
      "publicHostProfileMediaBaseUrl": "https://profiles-media.locally-travel.com",
      "workersDev": false,
      "previewUrls": false
    }
  },
  "bindings": {
    "staticAssets": "ASSETS",
    "images": "IMAGES",
    "incrementalCacheR2": "NEXT_INC_CACHE_R2_BUCKET",
    "publicExperienceMediaR2": "PUBLIC_EXPERIENCE_MEDIA_R2",
    "publicExperienceMediaQueueProducer": "PUBLIC_EXPERIENCE_MEDIA_QUEUE",
    "experienceTranslationQueueProducer": "EXPERIENCE_TRANSLATION_QUEUE",
    "queueDurableObject": {
      "binding": "NEXT_CACHE_DO_QUEUE",
      "className": "DOQueueHandler"
    },
    "tagCacheDurableObject": {
      "binding": "NEXT_TAG_CACHE_DO_SHARDED",
      "className": "DOShardedTagCache"
    },
    "selfService": "WORKER_SELF_REFERENCE"
  },
  "publicExperienceMediaQueuePolicy": {
    "maxBatchSize": 1,
    "maxConcurrency": 1,
    "maxRetries": 5,
    "retryDelaySeconds": 60
  },
  "experienceTranslationQueuePolicy": {
    "maxBatchSize": 1,
    "maxConcurrency": 1,
    "maxRetries": 5,
    "retryDelaySeconds": 60,
    "recoveryCron": "17 19 * * *"
  },
  "experienceTranslationReleasePolicy": {
    "defaultProductionProfile": "on",
    "queueEnabledVariable": "EXPERIENCE_TRANSLATION_QUEUE_ENABLED",
    "scheduledRecoveryEnabledVariable": "EXPERIENCE_TRANSLATION_SCHEDULED_RECOVERY_ENABLED",
    "rawDefault": "false"
  },
  "homePopularityReleasePolicy": {
    "defaultProductionProfile": "on",
    "scheduledEnabledVariable": "HOME_POPULARITY_SNAPSHOT_SCHEDULED_ENABLED",
    "rawDefault": "false",
    "cron": "17 19 * * *"
  },
  "adminSupportUnreadReleasePolicy": {
    "defaultProductionProfile": "on",
    "scheduledEnabledVariable": "ADMIN_SUPPORT_UNREAD_ALERTS_SCHEDULED_ENABLED",
    "rawDefault": "false",
    "cron": "*/10 * * * *"
  },
  "notificationRetentionReleasePolicy": {
    "defaultProductionProfile": "on",
    "scheduledEnabledVariable": "NOTIFICATION_RETENTION_CLEANUP_SCHEDULED_ENABLED",
    "rawDefault": "false",
    "cron": "31 19 * * *"
  },
  "experienceCompletionReleasePolicy": {
    "defaultProductionProfile": "on",
    "scheduledEnabledVariable": "EXPERIENCE_COMPLETION_SCHEDULED_ENABLED",
    "rawDefault": "false",
    "cron": "23 */2 * * *"
  },
  "serviceCompletionReleasePolicy": {
    "defaultProductionProfile": "off",
    "scheduledEnabledVariable": "SERVICE_COMPLETION_SCHEDULED_ENABLED",
    "rawDefault": "false",
    "cron": "23 */2 * * *"
  },
  "cancelPendingBookingsReleasePolicy": {
    "defaultProductionProfile": "off",
    "scheduledEnabledVariable": "CANCEL_PENDING_BOOKINGS_SCHEDULED_ENABLED",
    "rawDefault": "false",
    "cron": "7,37 * * * *"
  },
  "opsAnomalyMonitorReleasePolicy": {
    "defaultProductionProfile": "off",
    "scheduledEnabledVariable": "OPS_ANOMALY_MONITOR_SCHEDULED_ENABLED",
    "queueReadTokenSecret": "OPS_ANOMALY_MONITOR_CLOUDFLARE_API_TOKEN",
    "rawDefault": "false",
    "cron": "*/10 * * * *"
  },
  "publicExperienceMediaProducerPolicy": {
    "enabledVariable": "PUBLIC_EXPERIENCE_MEDIA_PRODUCER_ENABLED",
    "experienceIdsVariable": "PUBLIC_EXPERIENCE_MEDIA_PRODUCER_EXPERIENCE_IDS",
    "defaultEnabled": "false",
    "defaultExperienceIds": ""
  },
  "experienceMediaSourceReleasePolicy": {
    "defaultProductionProfile": "on",
    "enabledVariable": "EXPERIENCE_MEDIA_R2_SOURCE_ENABLED",
    "rawDefault": "false"
  },
  "publicExperienceMediaReaderPolicy": {
    "enabledVariable": "NEXT_PUBLIC_PUBLIC_EXPERIENCE_MEDIA_READER_ENABLED",
    "experienceIdsVariable": "NEXT_PUBLIC_PUBLIC_EXPERIENCE_MEDIA_READER_EXPERIENCE_IDS",
    "defaultEnabled": "false",
    "defaultExperienceIds": ""
  },
  "publicExperienceMediaReleasePolicy": {
    "defaultProductionProfile": "approved-cohort",
    "profiles": {
      "off": {
        "enabled": "false",
        "experienceIds": []
      },
      "single-3309": {
        "enabled": "true",
        "experienceIds": [3309]
      },
      "approved-cohort": {
        "enabled": "true",
        "experienceIds": [
          3071,
          3081,
          3188,
          3253,
          3307,
          3308,
          3309,
          3331,
          3343,
          3402,
          3403,
          3404,
          3405,
          3410,
          3416,
          3439,
          3496,
          3570,
          3664,
          3861,
          4262,
          4313,
          4397,
          4413,
          4414,
          4424,
          4523,
          4597,
          4659,
          4660,
          4811,
          4837,
          4838
        ]
      }
    }
  },
  "forbiddenIncrementalCacheR2Buckets": [
    "locally-public-experience-canary",
    "locally-public-host-profiles",
    "locally-private-host-profile-stale",
    "locally-production-db-backups"
  ],
  "cachePolicy": {
    "incrementalCache": "r2IncrementalCache",
    "queue": "doQueue",
    "tagCache": "doShardedTagCache",
    "baseShardSize": 12,
    "regionalCache": false,
    "enableCacheInterception": false,
    "automaticPurge": false
  },
  "environmentVariables": {
    "buildRequired": [
      "NEXT_PUBLIC_SITE_URL",
      "NEXT_PUBLIC_SUPABASE_URL",
      "NEXT_PUBLIC_SUPABASE_ANON_KEY"
    ],
    "productionBuildRequired": [
      "NEXT_PUBLIC_CLOUDFLARE_IMAGE_CANARY_BASE_URL",
      "NEXT_PUBLIC_CLOUDFLARE_HOST_PROFILE_BASE_URL",
      "NEXT_PUBLIC_PUBLIC_EXPERIENCE_MEDIA_READER_ENABLED",
      "NEXT_PUBLIC_PUBLIC_EXPERIENCE_MEDIA_READER_EXPERIENCE_IDS"
    ],
    "buildOptional": [
      "CI",
      "SENTRY_ORG",
      "SENTRY_PROJECT"
    ],
    "workerCoreRequired": [
      "NEXT_PUBLIC_SITE_URL",
      "NEXT_PUBLIC_SUPABASE_URL",
      "NEXT_PUBLIC_SUPABASE_ANON_KEY",
      "CLOUDFLARE_DEPLOYMENT_ENV"
    ],
    "workerFeatureVariables": [
      "CARD_PAYMENT_PROVIDER",
      "NICEPAY_MID",
      "PAYPAL_ENV",
      "PAYPAL_CLIENT_ID",
      "RESEND_FROM_EMAIL",
      "EMAIL_TRANSPORT_PROVIDER",
      "CLOUDFLARE_ACCOUNT_ID",
      "NEXT_PUBLIC_PORTONE_IMP_CODE",
      "NEXT_PUBLIC_PAYPAL_CLIENT_ID",
      "NEXT_PUBLIC_KAKAO_MAP_API_KEY",
      "NEXT_PUBLIC_ENABLE_KAKAO_IAB_ESCAPE",
      "NEXT_PUBLIC_GOOGLE_ANALYTICS_ACCOUNT_ID",
      "NEXT_PUBLIC_GOOGLE_ANALYTICS_PROPERTY_ID",
      "NEXT_PUBLIC_ADSENSE_ENABLED",
      "NEXT_PUBLIC_ADSENSE_CLIENT_ID",
      "NEXT_PUBLIC_ADSENSE_DESKTOP_RIGHT_RAIL_SLOT",
      "NEXT_PUBLIC_BANK_ACCOUNT",
      "NEXT_PUBLIC_BANK_ACCOUNT_HOLDER",
      "NEXT_PUBLIC_BANK_NAME",
      "NEXT_PUBLIC_BANK_OWNER",
      "NEXT_PUBLIC_SERVICE_OG_IMAGE",
      "NEXT_PUBLIC_CLOUDFLARE_IMAGE_CANARY_BASE_URL",
      "NEXT_PUBLIC_CLOUDFLARE_HOST_PROFILE_BASE_URL",
      "NEXT_PUBLIC_SENTRY_DSN",
      "NEXT_PUBLIC_SENTRY_ENVIRONMENT",
      "SENTRY_ENVIRONMENT",
      "PARTNERSHIP_INQUIRY_EMAIL",
      "TRANSLATION_GEMINI_MODEL",
      "TRANSLATION_GEMINI_FALLBACK_MODEL",
      "TRANSLATION_GROK_MODEL",
      "TRANSLATION_WORKER_BATCH_SIZE",
      "TRANSLATION_TASK_LEASE_SECONDS",
      "TRANSLATION_MAX_ATTEMPTS",
      "TRANSLATION_GEMINI_RESERVED_TOKENS",
      "TRANSLATION_GROK_RESERVED_TOKENS",
      "SETTLEMENT_SYNC_RUNNING_STALE_MINUTES",
      "SETTLEMENT_SYNC_DELAY_WARNING_MINUTES",
      "SETTLEMENT_SYNC_LEASE_SECONDS",
      "PUBLIC_EXPERIENCE_MEDIA_PRODUCER_ENABLED",
      "PUBLIC_EXPERIENCE_MEDIA_PRODUCER_EXPERIENCE_IDS",
      "EXPERIENCE_MEDIA_R2_SOURCE_ENABLED",
      "EXPERIENCE_TRANSLATION_QUEUE_ENABLED",
      "EXPERIENCE_TRANSLATION_SCHEDULED_RECOVERY_ENABLED",
      "HOME_POPULARITY_SNAPSHOT_SCHEDULED_ENABLED",
      "ADMIN_SUPPORT_UNREAD_ALERTS_SCHEDULED_ENABLED",
      "NOTIFICATION_RETENTION_CLEANUP_SCHEDULED_ENABLED",
      "EXPERIENCE_COMPLETION_SCHEDULED_ENABLED",
      "SERVICE_COMPLETION_SCHEDULED_ENABLED",
      "CANCEL_PENDING_BOOKINGS_SCHEDULED_ENABLED",
      "OPS_ANOMALY_MONITOR_SCHEDULED_ENABLED"
    ],
    "canarySafetyVariables": [
      "CLOUDFLARE_FUNCTIONAL_CANARY_ENABLED",
      "CLOUDFLARE_FUNCTIONAL_CANARY_ALLOW_STAGING_WRITES",
      "CLOUDFLARE_FUNCTIONAL_CANARY_SUPABASE_TIER",
      "CLOUDFLARE_FUNCTIONAL_CANARY_STAGING_SUPABASE_PROJECT_REF",
      "CLOUDFLARE_FUNCTIONAL_CANARY_STAGING_PROJECT_VERIFIED",
      "CLOUDFLARE_FUNCTIONAL_CANARY_ACTIVE_WRITE_GATE",
      "CLOUDFLARE_FUNCTIONAL_CANARY_PAYMENT_MODE",
      "CLOUDFLARE_FUNCTIONAL_CANARY_GOOGLE_OAUTH",
      "CLOUDFLARE_FUNCTIONAL_CANARY_KAKAO_OAUTH"
    ]
  },
  "secrets": {
    "workerAlways": [
      "SUPABASE_SERVICE_ROLE_KEY"
    ],
    "workerCanaryAlways": [
      "CLOUDFLARE_FUNCTIONAL_CANARY_SECRET"
    ],
    "workerFeatureStaged": {
      "cron": ["CRON_SECRET"],
      "gmail": [
        "GMAIL_USER",
        "GMAIL_APP_PASSWORD",
        "ADMIN_GMAIL_USER",
        "ADMIN_GMAIL_APP_PASSWORD"
      ],
      "cloudflareEmailSending": ["CLOUDFLARE_EMAIL_API_TOKEN"],
      "resendFallback": ["RESEND_API_KEY"],
      "portone": ["PORTONE_API_KEY", "PORTONE_API_SECRET"],
      "nicepay": ["NICEPAY_MERCHANT_KEY"],
      "paypal": ["PAYPAL_CLIENT_SECRET"],
      "sentryRuntime": ["SENTRY_DSN"],
      "translation": ["GEMINI_API_KEY", "XAI_API_KEY"],
      "opsAnomalyMonitorQueueRead": ["OPS_ANOMALY_MONITOR_CLOUDFLARE_API_TOKEN"]
    },
    "buildOnly": [
      "SENTRY_AUTH_TOKEN"
    ],
    "runnerOnly": [
      "CLOUDFLARE_ACCESS_CLIENT_ID",
      "CLOUDFLARE_ACCESS_CLIENT_SECRET",
      "CLOUDFLARE_CANARY_GUEST_EMAIL",
      "CLOUDFLARE_CANARY_GUEST_PASSWORD",
      "CLOUDFLARE_CANARY_GUEST_USER_ID",
      "CLOUDFLARE_CANARY_HOST_EMAIL",
      "CLOUDFLARE_CANARY_HOST_PASSWORD",
      "CLOUDFLARE_CANARY_HOST_USER_ID",
      "CLOUDFLARE_CANARY_INQUIRY_ID",
      "CLOUDFLARE_CANARY_EXPERIENCE_ID",
      "CLOUDFLARE_CANARY_STAGING_SUPABASE_IMAGE_URL",
      "CLOUDFLARE_CANARY_PUBLIC_R2_IMAGE_URL",
      "SUPABASE_SERVICE_ROLE_KEY"
    ]
  },
  "placementProfiles": {
    "default": null,
    "smart": { "mode": "smart" },
    "supabase-hint": { "mode": "targeted", "hostnameSource": "NEXT_PUBLIC_SUPABASE_URL.hostname" }
  },
  "publicReadPerformanceRoutes": [
    "/",
    "/search",
    "/experiences/{experienceId}",
    "/users/{userId}",
    "/api/home/experiences"
  ],
  "externalConfiguration": {
    "supabaseStagingRequiredBeforeCanaryWrites": true,
    "authCallbacks": [
      "/auth/callback"
    ],
    "oauthProviders": ["google", "kakao"],
    "paymentProviders": ["portone", "nicepay", "paypal"],
    "realtimeTransport": "browser-direct-to-supabase",
    "cronOwner": "github-actions"
  }
}
