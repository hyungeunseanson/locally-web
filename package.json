{
  "name": "locally-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cleanup:codex:dry": "node scripts/cleanup-codex-runtime-data.mjs",
    "cleanup:codex:execute": "node scripts/cleanup-codex-runtime-data.mjs --execute",
    "test:e2e:contracts:baseline": "playwright test -c playwright.contracts.config.ts tests/e2e/20-service-cancel-error-safe.spec.ts tests/e2e/21-service-payment-method-lock.spec.ts tests/e2e/56-notification-read-route.spec.ts tests/e2e/61-community-view-count.spec.ts tests/e2e/68-booking-rpc-public-guard.spec.ts tests/e2e/69-admin-role-access.spec.ts tests/e2e/71-public-host-profile.spec.ts tests/e2e/74-card-payment-precutover-contract.spec.ts --project=chromium --workers=1",
    "test:e2e:contracts:guards": "playwright test -c playwright.contracts.config.ts tests/e2e/75-experience-cancel-error-safe.spec.ts tests/e2e/76-card-callback-contract.spec.ts tests/e2e/77-notification-email-policy.spec.ts tests/e2e/78-internal-email-route-guard.spec.ts tests/e2e/79-team-notify-guard.spec.ts tests/e2e/80-public-service-role-contract.spec.ts tests/e2e/81-cron-secret-guards.spec.ts --project=chromium --workers=1",
    "test:e2e:contracts": "npm run test:e2e:contracts:baseline && npm run test:e2e:contracts:guards",
    "test:e2e:live:gate": "node scripts/run-live-smoke.mjs --bundle gate",
    "test:e2e:live:shared": "node scripts/run-live-smoke.mjs --bundle shared",
    "test:e2e:live:noisy": "node scripts/run-live-smoke.mjs --bundle noisy"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@react-email/components": "^1.0.8",
    "@react-email/render": "^2.0.4",
    "@sentry/nextjs": "^10.45.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.93.3",
    "@tanstack/react-query": "^5.90.21",
    "@tosspayments/payment-widget-sdk": "^0.12.1",
    "@vercel/analytics": "^1.6.1",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.34.3",
    "isomorphic-dompurify": "^3.0.0-rc.2",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "nodemailer": "^8.0.1",
    "react": "19.2.3",
    "react-confetti": "^6.4.0",
    "react-date-range": "^2.0.1",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19",
    "@types/react-date-range": "^1.4.10",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
