{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "locally-web-opennext-foundation",
  "main": "./cloudflare-worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "env": {
    "canary": {
      "name": "locally-web-opennext-canary",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "CLOUDFLARE_FUNCTIONAL_CANARY_ENABLED": "true",
        "CLOUDFLARE_DEPLOYMENT_ENV": "canary"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "redact_query_string": true
      },
      "images": {
        "binding": "IMAGES"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "locally-web-opennext-canary"
        }
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "locally-opennext-incremental-cache-canary"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "NEXT_CACHE_DO_QUEUE",
            "class_name": "DOQueueHandler"
          },
          {
            "name": "NEXT_TAG_CACHE_DO_SHARDED",
            "class_name": "DOShardedTagCache"
          }
        ]
      },
      "migrations": [
        {
          "tag": "opennext-cache-v1",
          "new_sqlite_classes": [
            "DOQueueHandler",
            "DOShardedTagCache"
          ]
        }
      ]
    },
    "production": {
      "name": "locally-web-opennext-production",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "CLOUDFLARE_DEPLOYMENT_ENV": "production",
        "PUBLIC_EXPERIENCE_MEDIA_PRODUCER_ENABLED": "false",
        "PUBLIC_EXPERIENCE_MEDIA_PRODUCER_EXPERIENCE_IDS": "",
        "EXPERIENCE_TRANSLATION_QUEUE_ENABLED": "false",
        "EXPERIENCE_TRANSLATION_SCHEDULED_RECOVERY_ENABLED": "false"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1,
        "redact_query_string": true
      },
      "images": {
        "binding": "IMAGES"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "locally-web-opennext-production"
        }
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "locally-opennext-incremental-cache-production"
        },
        {
          "binding": "PUBLIC_EXPERIENCE_MEDIA_R2",
          "bucket_name": "locally-public-experience-canary"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "PUBLIC_EXPERIENCE_MEDIA_QUEUE",
            "queue": "locally-public-experience-media-mirror-production"
          },
          {
            "binding": "EXPERIENCE_TRANSLATION_QUEUE",
            "queue": "locally-experience-translation-production"
          }
        ],
        "consumers": [
          {
            "queue": "locally-public-experience-media-mirror-production",
            "max_batch_size": 1,
            "max_retries": 5,
            "dead_letter_queue": "locally-public-experience-media-mirror-dlq-production",
            "max_concurrency": 1,
            "retry_delay": 60
          },
          {
            "queue": "locally-experience-translation-production",
            "max_batch_size": 1,
            "max_retries": 5,
            "dead_letter_queue": "locally-experience-translation-dlq-production",
            "max_concurrency": 1,
            "retry_delay": 60
          }
        ]
      },
      "triggers": {
        "crons": ["17 19 * * *"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "NEXT_CACHE_DO_QUEUE",
            "class_name": "DOQueueHandler"
          },
          {
            "name": "NEXT_TAG_CACHE_DO_SHARDED",
            "class_name": "DOShardedTagCache"
          }
        ]
      },
      "migrations": [
        {
          "tag": "opennext-cache-v1",
          "new_sqlite_classes": [
            "DOQueueHandler",
            "DOShardedTagCache"
          ]
        }
      ]
    }
  }
}
